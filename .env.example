# Copy to .env and fill in values

MONGODB_URI=

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Transactional email via Resend (optional — password reset)
RESEND_API_KEY=
EMAIL_FROM=
# Or use the pair below instead of EMAIL_FROM
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=EduPey

# Per-user API tokens (optional prefix for automation PATs)
AGENT_KEY_PREFIX=edupey_

PORT=3001

# Pey / CoDi: server-side only. Webhook secret comes from the Pey portal.
# Bank account is optional when the API key already has a CoDi account linked.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=
